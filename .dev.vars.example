# Copy to .dev.vars for local development. In production these are Worker secrets.

# Optional: the full URL Huddle is served from (no trailing slash). Leave empty to use the address
# it's opened at (locally http://localhost:8787); set it once Huddle has its own domain.
APP_URL=
# The first person to sign in with this email becomes the workspace owner.
ADMIN_EMAIL=
# At least 32 random characters. Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Optional: the name shown on outgoing email, e.g. "Acme Huddle <ignored@example.com>" (with Gmail,
# the address is always the connected Gmail account; only the name is used).
EMAIL_FROM=

# Optional email (invitations, emailed sign-in codes, summaries): a Gmail address and an app password
# for it (Google account > Security > 2-Step Verification on > App passwords). Best a dedicated Gmail.
# Without it, people sign in with an authenticator app.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=


# Optional: "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
