# Copy to .dev.vars for local development. In production these are Worker secrets.

# The full URL Huddle is served from (no trailing slash).
APP_URL=http://localhost:8787
# The first person to sign in with this email becomes the workspace owner.
ADMIN_EMAIL=
# At least 32 random characters. Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=

# Optional: the name shown on outgoing email, e.g. "Acme Huddle <ignored@example.com>" (with Gmail,
# the address is always the connected Gmail account; only the name is used).
EMAIL_FROM=

# Email through your own Gmail: an OAuth client from your Google Cloud project (Web application),
# with the Gmail API enabled. Then Admin > Email > Connect Gmail.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Optional: "Sign in with Google".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
