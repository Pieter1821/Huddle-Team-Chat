    {
      "name": "7. Sign back in as owner",
      "description": "Request a fresh code and paste it into `otp`.",
      "item": [
        {
          "name": "Request code (owner)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/email-otp/send-verification-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "email-otp", "send-verification-otp"]
            },
            "body": {
              "mode": "raw",
