    {
      "name": "9. Must fail",
      "description": "As owner. Every request here should be refused; a green test means the rule held.",
      "item": [
        {
          "name": "Setup cannot run twice",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/setup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "setup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workspaceName\": \"Another\",\n  \"yourName\": \"{{yourName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Already set up (409)', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        },
        {
          "name": "Cannot invite an existing member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{inviteEmail}}\",\n  \"role\": \"member\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Already a member (409)', () => pm.response.to.have.status(409));"]
              }
            }
          ]
        },
        {
          "name": "Guests need at least one channel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guest@example.com\",\n  \"role\": \"guest\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Rejected (400)', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "Nobody can be made owner",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/members/{{memberId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "{{memberId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"owner\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Rejected (400)', () => pm.response.to.have.status(400));"]
              }
            }
          ]
        },
        {
          "name": "Nobody changes their own role",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/members/{{ownerId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members", "{{ownerId}}"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"member\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Refused (403)', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        },
        {
          "name": "Cross-site request is blocked",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "https://evil.example"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/workspace",
              "host": ["{{baseUrl}}"],
              "path": ["api", "workspace"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Hacked\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Same request as a real settings change, but claiming to come from another site."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('CSRF guard (403)', () => pm.response.to.have.status(403));"]
              }
            }
          ]
        },
        {
          "name": "Stranger gets no code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/email-otp/send-verification-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "email-otp", "send-verification-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"stranger@example.com\",\n  \"type\": \"sign-in\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Answers 200 like any other request (so membership is not revealed), but nothing prints in the dev terminal."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Same answer as everyone (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
