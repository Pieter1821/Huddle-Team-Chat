{
  "info": {
    "name": "Huddle API",
    "description": "Every Huddle endpoint, in the order you would use them. Step through the folders top to bottom.\n\nSetup: import this collection and the \"Huddle — local\" environment, select the environment, set `email` to your ADMIN_EMAIL, and keep `npm run dev` running.\n\nSign-in codes print in the `npm run dev` terminal while running locally. Paste the owner's code into `otp` and the invitee's into `memberOtp`. Postman keeps the session cookie; signing in as someone else replaces it.\n\nAn Origin header is added automatically (collection pre-request script) unless a request sets its own, because the API refuses state-changing requests from other origins (CSRF protection).\n\nLeft out on purpose (they would lock you out for up to an hour): requesting more than 5 codes in an hour (429) and 3 wrong codes in a row (the code is burned).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// The API only accepts state-changing requests from its own origin (CSRF guard).",
          "// A request that sets its own Origin (the \"evil origin\" test) keeps it.",
          "if (!pm.request.headers.has('Origin')) {",
          "  pm.request.headers.add({ key: 'Origin', value: pm.environment.get('baseUrl') });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "description": "Is the Worker running and does the database answer?",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Healthy (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Database ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/setup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "setup"]
            },
            "description": "`needsSetup: true` until the first owner creates the workspace."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Answered (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Sign in as owner",
      "description": "Uses `email` (your ADMIN_EMAIL) and `otp`.",
      "item": [
        {
          "name": "Request sign-in code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/email-otp/send-verification-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "email-otp", "send-verification-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"type\": \"sign-in\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Sends a 6-digit code (printed in the dev terminal locally). Codes go only to the admin email or invited people."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Code requested (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Sign in with code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/email-otp",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-in", "email-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Paste the code from the `npm run dev` terminal into the `otp` variable first. Codes expire after 5 minutes and allow 3 attempts."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signed in (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Session cookie set', () => pm.expect(pm.cookies.has('huddle.session_token')).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current session",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/get-session",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "get-session"]
            },
            "description": "Better Auth's own endpoint: the session and user behind your cookie."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Session returned (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Has a user', () => pm.expect(pm.response.json().user.email).to.be.a('string'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Request magic link (optional)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/sign-in/magic-link",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "sign-in", "magic-link"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"callbackURL\": \"/api/me\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Alternative to codes. A sign-in link prints in the dev terminal: paste the whole URL into the `magicLink` variable, then send the next request."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Link requested (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Open magic link (optional)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{magicLink}}"
            },
            "description": "Verifies the link, sets the session cookie and redirects to /api/me. Links work once and expire after 5 minutes."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Signed in via link (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Landed on /api/me', () => pm.expect(pm.response.json().role).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
