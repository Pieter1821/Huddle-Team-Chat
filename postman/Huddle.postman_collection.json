                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "8. Members",
      "description": "As owner.",
      "item": [
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "members"]
            },
            "description": "Admins see everyone (with status); members see active people; guests see only people in their channels, without emails."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Listed (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Includes the invitee', () => pm.expect(pm.response.json().members.map((m) => m.userId)).to.include(pm.environment.get('memberId')));"
                ]
              }
            }
          ]
        },
        {
