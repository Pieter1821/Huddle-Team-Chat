    {
      "name": "5. Invitations",
      "description": "Invites `inviteEmail` as a member, and shows revoking with a second, throwaway invite.",
      "item": [
        {
          "name": "Invite a member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{inviteEmail}}\",\n  \"role\": \"member\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Returns a one-time `link`; the token is shown only here. The invitation email prints in the dev terminal. For a guest use role \"guest\" plus \"conversationIds\": [\"<channel id>\"]."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created (201) or already a member (409)', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.environment.set('invitationId', body.invitation.id);",
                  "  pm.environment.set('inviteToken', body.link.split('/invite/')[1]);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Look up invitation by link",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/by-token/{{inviteToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "by-token", "{{inviteToken}}"]
            },
            "description": "What the invite landing page shows. Public; 404 once used, revoked or expired."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Invitation found (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "List pending invitations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations"]
            },
            "description": "Owners and admins only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Listed (200)', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Invite someone to revoke",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/invitations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{revokeEmail}}\",\n  \"role\": \"member\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Created (201)', () => pm.response.to.have.status(201));",
                  "pm.environment.set('revokeInvitationId', pm.response.json().invitation.id);",
                  "pm.environment.set('revokeToken', pm.response.json().link.split('/invite/')[1]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Revoke that invitation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/{{revokeInvitationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "{{revokeInvitationId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Revoked (204)', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Revoked link no longer works",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/invitations/by-token/{{revokeToken}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "invitations", "by-token", "{{revokeToken}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('Gone (404)', () => pm.response.to.have.status(404));"]
              }
            }
          ]
        }
      ]
    },
