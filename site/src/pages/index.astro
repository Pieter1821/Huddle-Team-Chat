---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Intro from '../components/Intro.astro';
import TryIt from '../components/TryIt.astro';
import Journey from '../components/Journey.astro';
import Screens from '../components/Screens.astro';
import Tour from '../components/Tour.astro';
import How from '../components/How.astro';
import Features from '../components/Features.astro';
import Teams from '../components/Teams.astro';
import Ledger from '../components/Ledger.astro';
import Inside from '../components/Inside.astro';
import DocsList from '../components/DocsList.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
---

<Base
  title="Huddle: free team chat on your own Cloudflare account"
  description="Free, open-source team chat with channels, threads, files and search. Deploy it to your own Cloudflare account in minutes: no per-seat price, your data stays yours."
>
  <main id="main">
    <Hero />
    <Intro />
    <Journey />
    <TryIt />
    <Teams />
    <Tour />
    <Features />
    <How />
    <Screens />
    <Ledger />
    <Inside />
    <DocsList />
    <Faq />
    <Cta />
  </main>
</Base>
