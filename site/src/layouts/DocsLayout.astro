---
/**
 * A documentation page: sections in a sidebar (a drawer on phones), breadcrumb, the page, its
 * table of contents, previous and next, search, and a reading-progress bar.
 */
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Icon from '../components/Icon.astro';
import Search from '../components/docs/Search.astro';
import { SECTIONS, allDocs, docHref, minutes, type Doc } from '../lib/docs';
import { REPO_URL } from '../lib/links';

interface Props {
  doc: Doc;
  headings: MarkdownHeading[];
}
const { doc, headings } = Astro.props;
const docs = await allDocs();
const i = docs.findIndex((d) => d.id === doc.id);
const prev = docs[i - 1];
const next = docs[i + 1];
const section = SECTIONS.find((s) => s.id === doc.data.section)!;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const editUrl = `${REPO_URL}/edit/main/site/src/content/docs/${doc.id}.mdx`;
---

<Base title={`${doc.data.title} · Huddle docs`} description={doc.data.description} active="docs">
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
  <div class="docs-shell">
    <aside class="sidebar" id="docs-nav" data-sidebar>
      <Search />
      <nav aria-label="Documentation">
        {
          SECTIONS.map((s) => {
            const pages = docs.filter((d) => d.data.section === s.id);
            return (
              <div class="side-group">
                <p class="side-name">{s.name}</p>
                <ul role="list">
                  {pages.map((d) => (
                    <li>
                      <a href={docHref(d)} aria-current={d.id === doc.id ? 'page' : undefined}>
                        {d.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            );
          })
        }
      </nav>
    </aside>

    <main id="main" class="doc">
      <div class="doc-top">
        <button class="menu-btn" type="button" aria-controls="docs-nav" aria-expanded="false" data-menu>
          <Icon name="menu" size={18} /> Menu
        </button>
        <nav aria-label="Breadcrumb" class="crumbs">
          <ol role="list">
            <li><a href="/docs">Docs</a></li>
            <li><a href={docHref(docs.find((d) => d.data.section === section.id)!)}>{section.name}</a></li>
            <li aria-current="page">{doc.data.title}</li>
          </ol>
        </nav>
      </div>
      <article class="prose" data-pagefind-body>
        <h1>{doc.data.title}</h1>
        <p class="desc">{doc.data.description}</p>
        <p class="meta">{minutes(doc)} min read</p>
        <slot />
      </article>
      <nav class="pager" aria-label="Previous and next">
        {
          prev ? (
            <a class="prev" href={docHref(prev)}>
              <span class="soft small">Previous</span>
              <span>{prev.data.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="next" href={docHref(next)}>
              <span class="soft small">Next</span>
              <span>{next.data.title}</span>
            </a>
          )
        }
      </nav>
      <p class="edit small"><a class="link" href={editUrl}>Suggest a change to this page</a></p>
    </main>

    <aside class="toc" aria-label="On this page">
      {
        toc.length > 0 && (
          <>
            <p class="toc-title">On this page</p>
            <ul role="list" data-toc>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </aside>
  </div>
  <div class="scrim" data-scrim hidden></div>
</Base>

<style is:global>
  .docs-shell {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr) 220px;
    gap: 48px;
    padding: 24px var(--m) 0;
    max-width: 1440px;
    margin: 0 auto;
  }
  .progress {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    height: 3px;
    z-index: 49;
  }
  .progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }
  .sidebar {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    align-self: start;
    max-height: calc(100svh - var(--nav-h) - 48px);
    overflow-y: auto;
    padding-right: 8px;
    scrollbar-width: thin;
  }
  .side-group {
    margin-top: 28px;
  }
  .side-name {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 6px;
  }
  .sidebar a {
    position: relative;
    display: block;
    padding: 6px 12px;
    border-radius: var(--r);
    font-size: 15px;
    text-decoration: none;
    color: var(--muted);
    transition:
      color 0.2s,
      background-color 0.2s;
  }
  .sidebar a:hover {
    color: var(--ink);
    background: var(--surface);
  }
  .sidebar a[aria-current='page'] {
    color: var(--ink);
    background: var(--surface-2);
  }
  .sidebar a[aria-current='page']::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 3px;
    border-radius: 2px;
    background: var(--accent);
  }
  .doc {
    min-width: 0;
    max-width: 760px;
  }
  .doc-top {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .menu-btn {
    display: none;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--r);
    background: var(--surface-2);
    cursor: pointer;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
  }
  .crumbs li + li::before {
    content: '›';
    margin-right: 6px;
    color: var(--meta);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--ink);
  }

  /* The page itself */
  .prose {
    margin-top: 28px;
    font-size: 17px;
    line-height: 1.65;
  }
  .prose h1 {
    font-size: clamp(36px, 4vw, 56px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 600;
  }
  .prose .desc {
    margin-top: 16px;
    font-size: 21px;
    line-height: 1.4;
    color: var(--muted);
  }
  .prose .meta {
    margin-top: 12px;
    font-size: 14px;
    color: var(--meta);
  }
  .prose h2 {
    margin-top: 56px;
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .prose h3 {
    margin-top: 36px;
    font-size: 20px;
    font-weight: 600;
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .prose h2 a.anchor,
  .prose h3 a.anchor {
    text-decoration: none;
  }
  .prose p,
  .prose ul,
  .prose ol,
  .prose table,
  .prose pre,
  .prose figure,
  .prose aside {
    margin-top: 18px;
  }
  .prose ul,
  .prose ol {
    padding-left: 24px;
  }
  .prose li + li {
    margin-top: 6px;
  }
  .prose li::marker {
    color: var(--meta);
  }
  .prose a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
    text-decoration-thickness: 2px;
  }
  .prose a:hover {
    background: var(--accent-soft);
  }
  .prose strong {
    font-weight: 600;
  }
  .prose :not(pre) > code {
    font-family: var(--code);
    font-size: 0.86em;
    background: var(--surface-2);
    padding: 2px 6px;
    border-radius: 4px;
    overflow-wrap: anywhere;
  }
  .prose pre {
    position: relative;
    padding: 18px 20px;
    border-radius: var(--r);
    background: var(--surface) !important;
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.6;
  }
  .prose pre code {
    font-family: var(--code);
  }
  .copy-btn {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 10px;
    border: 0;
    border-radius: 4px;
    background: var(--surface-2);
    color: var(--muted);
    font-family: var(--font);
    font-size: 13px;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.2s,
      color 0.2s;
  }
  .prose pre:hover .copy-btn,
  .copy-btn:focus-visible,
  .copy-btn.done {
    opacity: 1;
  }
  .copy-btn.done {
    color: var(--accent);
  }
  @media (hover: none) {
    .copy-btn {
      opacity: 1;
    }
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    display: block;
    overflow-x: auto;
  }
  .prose th,
  .prose td {
    text-align: left;
    vertical-align: top;
    padding: 10px 14px 10px 0;
    border-bottom: 1px solid var(--surface-2);
  }
  .prose th {
    font-weight: 600;
    color: var(--muted);
  }
  .doc-fig {
    margin-inline: 0;
  }
  .doc-fig img,
  .doc-fig video,
  .doc-fig .missing {
    border-radius: var(--r);
    background: var(--surface);
  }
  .doc-fig figcaption {
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }
  [data-zoom] img {
    cursor: zoom-in;
  }
  .callout {
    padding: 16px 20px;
    border-radius: var(--r);
    background: var(--surface);
    box-shadow: inset 3px 0 0 var(--accent);
  }
  .callout.warn {
    box-shadow: inset 3px 0 0 var(--attention);
  }
  .callout > :first-child {
    margin-top: 0;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 72px;
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 18px 20px;
    border-radius: var(--r);
    background: var(--surface);
    text-decoration: none;
    font-size: 17px;
    font-weight: 500;
    transition:
      background-color 0.2s,
      transform 0.3s var(--ease-out);
  }
  .pager a:hover {
    background: var(--surface-2);
  }
  .pager .prev:hover {
    transform: translateX(-4px);
  }
  .pager .next {
    text-align: right;
    grid-column: 2;
  }
  .pager .next:hover {
    transform: translateX(4px);
  }
  .edit {
    margin-top: 24px;
    color: var(--muted);
  }

  .toc {
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    align-self: start;
    font-size: 14px;
  }
  .toc-title {
    color: var(--muted);
    margin-bottom: 8px;
  }
  .toc a {
    display: block;
    padding: 4px 0 4px 12px;
    text-decoration: none;
    color: var(--muted);
    box-shadow: inset 2px 0 0 var(--surface-2);
    transition:
      color 0.2s,
      box-shadow 0.2s;
  }
  .toc .d3 a {
    padding-left: 24px;
  }
  .toc a:hover {
    color: var(--ink);
  }
  .toc a.on {
    color: var(--ink);
    box-shadow: inset 2px 0 0 var(--accent);
  }
  .scrim {
    position: fixed;
    inset: 0;
    z-index: 59;
    background: rgb(0 0 0 / 0.55);
  }

  @media (max-width: 1200px) {
    .docs-shell {
      grid-template-columns: 240px minmax(0, 1fr);
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .docs-shell {
      display: block;
      padding-top: 16px;
    }
    .menu-btn {
      display: inline-flex;
    }
    .sidebar {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      z-index: 60;
      width: min(320px, 86vw);
      max-height: none;
      padding: 20px 16px 40px;
      background: var(--bg);
      transform: translateX(-102%);
      transition: transform 0.35s var(--ease-out);
    }
    .sidebar.open {
      transform: none;
      box-shadow: 20px 0 60px rgb(0 0 0 / 0.5);
    }
    .sidebar a {
      padding: 10px 12px;
    }
    .crumbs {
      display: none;
    }
    .prose .desc {
      font-size: 18px;
    }
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .next {
      grid-column: 1;
    }
  }
</style>

<script>
  // Copy buttons on code, the reading bar, the table of contents that follows you, the phone menu.
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
        btn.textContent = 'Copied';
        btn.classList.add('done');
        setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('done');
        }, 1600);
      } catch {
        btn.textContent = 'Press Ctrl+C';
      }
    });
    pre.append(btn);
  });

  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const article = document.querySelector<HTMLElement>('.prose');
  if (bar && article) {
    let raf = 0;
    const set = () => {
      raf = 0;
      const r = article.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.4 - r.top) / r.height));
      bar.style.transform = `scaleX(${p})`;
    };
    addEventListener('scroll', () => (raf ||= requestAnimationFrame(set)), { passive: true });
    set();
  }

  const toc = document.querySelector('[data-toc]');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('a')];
    const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1)))).filter(Boolean) as HTMLElement[];
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((a) => a.classList.toggle('on', a.hash.slice(1) === e.target.id));
        }
      },
      { rootMargin: '-15% 0px -75% 0px' },
    );
    targets.forEach((t) => io.observe(t));
  }

  const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
  const side = document.querySelector<HTMLElement>('[data-sidebar]');
  const scrim = document.querySelector<HTMLElement>('[data-scrim]');
  if (menu && side && scrim) {
    const open = (on: boolean) => {
      side.classList.toggle('open', on);
      scrim.hidden = !on;
      menu.setAttribute('aria-expanded', String(on));
      document.body.style.overflow = on ? 'hidden' : '';
      if (on) side.querySelector<HTMLElement>('[aria-current="page"]')?.focus();
    };
    menu.addEventListener('click', () => open(true));
    scrim.addEventListener('click', () => open(false));
    addEventListener('keydown', (e) => e.key === 'Escape' && side.classList.contains('open') && (open(false), menu.focus()));
  }
</script>
